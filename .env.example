# The launchers copy this file to %LOCALAPPDATA%\Ternfold\.env.
# Keep real credentials there, outside the OneDrive source folder.
# Local demo PostgreSQL (used when both database variables below are blank):
# TERNFOLD_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/ternfold

# Supabase: copy the Session pooler connection string from
# Project Settings > Database > Connect. Replace [YOUR-PASSWORD].
SUPABASE_DATABASE_URL=

# Optional extraction. Choose openrouter, anthropic, or nvidia. The app remains complete
# in manual-review mode when these are blank.
TERNFOLD_AI_PROVIDER=nvidia
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813

TERNFOLD_SECURE_COOKIES=0
TERNFOLD_DEMO_DATE=2026-09-03

